{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/hooks/adapters/claude/run.mjs\" block-dangerous"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/hooks/adapters/claude/run.mjs\" work-plan-enforcer"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/hooks/adapters/claude/run.mjs\" plan-completion-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/hooks/adapters/claude/run.mjs\" layer-doc-reminder"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/hooks/adapters/claude/run.mjs\" work-plan-enforcer"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/hooks/adapters/claude/run.mjs\" plan-update-reminder"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read file_path; if echo \"$file_path\" | grep -qE '\\.kts?$'; then \"$CLAUDE_PROJECT_DIR/.claude/hooks/ktlint-format.sh\"; fi; }",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/markdown_formatter.py\""
          }
        ]
      }
    ]
  }
}
